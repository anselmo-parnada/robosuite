    <headlight ambient="0.1 0.1 0.1" diffuse="0.1 0.1 0.1" specular="0.1 0.1 0.1" active="0"/>
  </visual>

  <actuator>
  </actuator>

  <worldbody>
  </worldbody>

  <equality>
  </equality>
</mujoco>